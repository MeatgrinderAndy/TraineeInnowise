[QUERIES]
COUNT_STUDENTS_IN_ROOMS = SELECT rooms.name, COUNT(students.id) AS student_count FROM rooms LEFT OUTER JOIN students ON rooms.id = students.room_id GROUP BY rooms.id ORDER BY student_count DESC
SMALLEST_AVG_AGE_GAP = SELECT r.id AS room_id, r.name AS room_name, ROUND(AVG(EXTRACT(YEAR FROM AGE(NOW(), s.birthday)))::numeric, 2) AS average_age FROM rooms r INNER JOIN students s ON r.id = s.room_id GROUP BY r.id, r.name ORDER BY average_age ASC LIMIT 5;
LARGEST_AGE_DIFFERENCE = SELECT r.id AS room_id, r.name AS room_name, MAX(EXTRACT(YEAR FROM AGE(NOW(), s.birthday))) - MIN(EXTRACT(YEAR FROM AGE(NOW(), s.birthday))) AS age_difference FROM rooms r INNER JOIN students s ON r.id = s.room_id GROUP BY r.id, r.name HAVING COUNT(s.id) > 1 ORDER BY age_difference DESC LIMIT 5;
MIXED_GENDERS_ROOMS = SELECT r.name AS room_name FROM rooms r INNER JOIN students s ON r.id = s.room_id GROUP BY r.id, r.name HAVING COUNT(DISTINCT s.sex) > 1 ORDER BY r.id;